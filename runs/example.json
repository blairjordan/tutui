{
  "name": "example ramp",
  "description": "Synthetic ramp from docs/example-scenario.mjs: concurrency 10 \u2192 25 \u2192 50 \u2192 100 against a backend that saturates at 60/s. Watch latency climb and the queue stop draining; the header names the ceiling.",
  "scenario": "process",
  "params": {
    "command": [
      "node",
      "../docs/example-scenario.mjs"
    ],
    "params": {
      "stages": [
        10,
        25,
        50,
        100
      ],
      "stage_seconds": 20,
      "capacity": 60
    }
  },
  "chart_window_seconds": 90,
  "thresholds": [
    {
      "metric": "latency_ms",
      "stat": "p95",
      "max": 250
    },
    {
      "metric": "requests",
      "stat": "share",
      "labels": {
        "status": "200"
      },
      "min": 0.99
    },
    {
      "metric": "queue_depth",
      "stat": "slope",
      "max": 0.5
    }
  ]
}
